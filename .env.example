# Copy to .env and fill in GEMINI_API_KEY. Never commit .env.

# --- AI provider: "gemini" (cloud) or "ollama" (local, nothing leaves your machine) ---
# Gemini FREE tier: Google may use prompts to improve its products.
# For real team meetings use a paid Gemini key or switch both providers to ollama.
LLM_PROVIDER=gemini
EMBED_PROVIDER=gemini
GEMINI_API_KEY=your-key-from-aistudio.google.com
LLM_MODEL=gemini-flash-latest
# Tried in order when the main model is overloaded (free tier hits this often)
LLM_FALLBACK_MODELS=gemini-flash-lite-latest
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_SIZE=768

# --- Ollama (used when a provider above is "ollama"; also the LLM fallback) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=16384

# --- Duplicate detection (changing EMBED_PROVIDER requires re-ingesting tickets) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=meeting_corpus
DEDUP_THRESHOLD=0.78

# --- Integrations / transcription ---
MOCK_INTEGRATIONS=true
WHISPER_MODEL=base
LOG_LEVEL=INFO
